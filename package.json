{
  "name": "privacy-payments",
  "version": "1.0.0",
  "description": "L0 simulated private invoice, approval, verification and scoped disclosure MVP",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.check.json",
    "lint": "eslint src tests",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write src public tests *.json *.ts *.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seasonHxy/privacy-payments.git"
  },
  "keywords": [],
  "author": "",
  "type": "module",
  "bugs": {
    "url": "https://github.com/seasonHxy/privacy-payments/issues"
  },
  "homepage": "https://github.com/seasonHxy/privacy-payments#readme",
  "dependencies": {
    "express": "5.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  },
  "private": true,
  "engines": {
    "node": ">=24 <25"
  }
}
