{
  "name": "privacy-payments",
  "version": "1.0.0",
  "description": "L0 simulated private invoice, approval, verification and scoped disclosure MVP",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc && node scripts/build-wallet.mjs",
    "typecheck": "tsc -p tsconfig.check.json",
    "lint": "eslint src tests scripts",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write src public/*.js public/*.html public/*.css tests scripts/*.ts scripts/*.mjs *.json *.ts *.mjs",
    "test:postgres": "tsx --test tests/postgres/*.test.ts",
    "db:migrate": "STORAGE_DRIVER=postgres MIGRATE_ONLY=1 tsx src/server.ts",
    "test:e2e:postgres": "tsx scripts/test-postgres-e2e.ts",
    "predev": "node scripts/build-wallet.mjs",
    "test:restore": "tsx --test tests/restore/*.test.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seasonHxy/privacy-payments.git"
  },
  "keywords": [],
  "author": "",
  "type": "module",
  "bugs": {
    "url": "https://github.com/seasonHxy/privacy-payments/issues"
  },
  "homepage": "https://github.com/seasonHxy/privacy-payments#readme",
  "dependencies": {
    "@hot-labs/near-connect": "0.11.4",
    "bs58": "6.0.0",
    "express": "5.3.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  },
  "private": true,
  "engines": {
    "node": ">=24 <25"
  }
}
